# ─── ILYAS AI COMMERCE — пример переменных окружения ───
# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НИКОГДА не коммитится в git (он в .gitignore).

# База данных PostgreSQL
DATABASE_URL="postgresql://ilyas:CHANGE_ME@localhost:5432/ilyas_commerce?schema=public"

# Секрет для подписи сессий (минимум 32 случайных символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Учётная запись владельца, создаётся командой `npm run db:seed`
OWNER_EMAIL="owner@example.kz"
OWNER_PASSWORD="CHANGE_ME_strong_password"
OWNER_NAME="Ильяс"

# Загружать демонстрационные данные при seed (true/false)
SEED_DEMO_DATA="true"

# ─── Подключаются на следующих этапах (пока не используются) ───
# Этап 3 — Kaspi (токен из кабинета продавца, если доступен)
KASPI_API_TOKEN=""
# Этап 6 — ИИ (заполните один из ключей)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Этап 7 — Telegram-бот
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_CHAT_ID=""
